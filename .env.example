NODE_ENV=development
DATABASE_URL=postgres://pi_swarm:pi_swarm@localhost:5432/pi_swarm
LOG_LEVEL=debug
PERSONA_RUNTIME_ROOT=./var/personas
PI_COMMAND=pi
# PI_CLI_PATH=/home/lenovo-docker/node_modules/@earendil-works/pi-coding-agent/dist/cli.js
# PI_COMMAND=node
PI_PROVIDER=vllm
PI_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
PI_RPC_TIMEOUT_MS=120000
USE_FAKE_WORKER=false
MEMORY_PROVIDER=remnic
REMNIC_ENDPOINT=http://127.0.0.1:4318
# REMNIC_AUTH_TOKEN=
REMNIC_TIMEOUT_MS=8000
MEMORY_RECALL_MAX_ITEMS=8
MEMORY_RECALL_MAX_CHARS=6000
MEMORY_EXTRACTION_ENABLED=true
MEMORY_CURATION_POLL_INTERVAL_MS=2000
POLL_LONG_TIMEOUT_SECONDS=30
LEASE_TTL_SECONDS=60
LEASE_RENEW_INTERVAL_SECONDS=20
MAX_TELEGRAM_MESSAGE_LENGTH=4096
TELEGRAM_TYPING_ENABLED=true
TELEGRAM_TYPING_REFRESH_MS=4000
TELEGRAM_PROGRESS_ENABLED=true
TELEGRAM_PROGRESS_MIN_INTERVAL_MS=2500
TELEGRAM_PROGRESS_HEARTBEAT_MS=30000
AI_STACK_URL=http://10.0.0.171:7000
TELEGRAM_AUDIO_ENABLED=true
TELEGRAM_AUDIO_REPLY_ENABLED=true
GX10_STT_TIMEOUT_MS=120000
GX10_TTS_TIMEOUT_MS=300000
